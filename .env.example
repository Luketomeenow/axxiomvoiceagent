# ============================================================================
# Axxiom Voice Agents — environment (LOCAL development)
# Copy to `.env` and fill in. Bun auto-loads `.env` (no dotenv needed); Node:
# `node --env-file=.env`. In Azure these are App Service settings — secrets as
# Key Vault references — pushed by scripts/azure/sync-app-settings.sh.
# Nothing here is required to BOOT the server (it starts so the health check
# passes), but each feature logs a warning until its keys are present.
# Keep production keys OUT of a laptop .env where you can (see docs/azure.md).
# ============================================================================

# --- Server ---------------------------------------------------------------
PORT=3000
# Public base URL of THIS service (App Service: https://<app>.azurewebsites.net).
# Used as the Vapi webhook target: ${SERVER_URL}/vapi/webhook
SERVER_URL=

# --- Database ---------------------------------------------------------------
# Production is Azure Database for PostgreSQL (psql-axxiom-marketing/axxiom_hub),
# reached with a managed-identity Entra token — no password. Locally, point at a
# local Postgres (brew install postgresql@18; apply scripts/azure/sql/voice_schema.sql):
#   DATA_BACKEND=azure  AZURE_PG_HOST=127.0.0.1  AZURE_PG_DATABASE=voice_dev
#   AZURE_PG_USER=<local role>  AZURE_PG_PASSWORD=<pw>  AZURE_PG_SSL=disable
# …or at Azure itself from Cloud Shell: AZURE_PG_USER=<your Entra email>, no password.
# Unset DATA_BACKEND = azure if AZURE_PG_USER is set, else the legacy Supabase keys below.
DATA_BACKEND=
AZURE_PG_HOST=
AZURE_PG_PORT=5432
AZURE_PG_DATABASE=
AZURE_PG_USER=
# App Service only: client id of the user-assigned managed identity.
AZURE_PG_CLIENT_ID=
# Local Postgres only — never set these in Azure.
AZURE_PG_PASSWORD=
AZURE_PG_SSL=

# Kill switch for everything that places calls (campaign worker, call-now, test
# calls). false on any instance that must not dial (e.g. during a parallel run).
DIALER_ENABLED=true

# --- Vapi -----------------------------------------------------------------
VAPI_API_KEY=
# Optional: org JWT secret (Vapi dashboard -> Org Settings). Lets the analytics
# page show the remaining Vapi credit balance; verify with `bun run check-balances`.
VAPI_JWT_SECRET=
# Filled in automatically after you run `bun run create-assistant` the first time.
VAPI_ASSISTANT_ID=
# Optional: the Vapi phone-number id to attach the assistant to.
VAPI_PHONE_NUMBER_ID=
# Shared secret Vapi sends as the `x-vapi-secret` header. Set any random string
# here AND in the assistant's server config (create-assistant does this for you).
# REQUIRED in production: if unset, /vapi/webhook now FAILS CLOSED (503).
VAPI_SERVER_SECRET=
# Local dev escape hatch ONLY — allow the webhook to run without a secret.
# Never set this in production.
ALLOW_INSECURE_WEBHOOK=false

# --- Twilio (BYO caller-ID numbers + telephony cost sync) -----------------
# Used by `import-twilio-numbers` to register your DIDs in Vapi, AND by the
# server to pull authoritative per-call cost/status/answered-by from Twilio
# (src/outbound/twilioSync.ts, POST /outbound/twilio/sync + auto every ~5 min).
# Set these in App Service too (sync-app-settings.sh) for cost analytics.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Outbound qualification campaign --------------------------------------
# Filled in automatically after `bun run create-outbound-assistant`.
OUTBOUND_ASSISTANT_ID=
# Leads are CA-based; calling-window logic uses this timezone + 8am-9pm (TCPA).
OUTBOUND_TIMEZONE=America/Los_Angeles
CALL_WINDOW_START=8
CALL_WINDOW_END=21
# How many calls the campaign worker runs at once, and max attempts per lead.
MAX_CONCURRENT_CALLS=1
MAX_CALL_ATTEMPTS=3
# Per-number frequency cap: max dials to one phone in a rolling 24h across ALL
# leads sharing it (one number can map to several buildings). TCPA-adjacent.
MAX_CALLS_PER_NUMBER_PER_DAY=3
# Data retention: purge call transcripts/recordings/raw payloads older than this
# (POST /outbound/retention/purge). Structural rows + metrics are kept.
PII_RETAIN_DAYS=90
# Voicemail detection (Vapi transcription-based). ON for the real campaign —
# leaves a compliant voicemail + dispositions/retries the lead instead of
# pitching a machine. Set false only if live test calls get misclassified.
ENABLE_VOICEMAIL_DETECTION=true

# --- GoHighLevel (LeadConnector v2) ---------------------------------------
# Reuses the same conventions as axxiommarketinghub.
GHL_ACCESS_TOKEN=
GHL_LOCATION_ID=
# Calendar that site surveys get booked into.
GHL_CALENDAR_ID=
# Pipeline + stage a brand-new inbound lead opportunity lands in.
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
# IANA timezone used for booking + call-window logic.
GHL_TIMEZONE=America/New_York

# --- Transfer / safety net ------------------------------------------------
# Number warm-transfers (hot leads, "get me a person", emergencies) ring.
TRANSFER_PHONE_NUMBER=
# What the agent tells a caller to do if it cannot transfer during an emergency.
EMERGENCY_INSTRUCTION=hang up and dial 911

# --- Voice + LLM (the brain runs inside Vapi) -----------------------------
# ElevenLabs voice id for the branded Axxiom voice. Add the ElevenLabs API key
# itself in the Vapi dashboard (Provider Keys) for calls.
ELEVENLABS_VOICE_ID=
# Optional: enables the dashboard "Voice" picker to list your ElevenLabs voices
# + previews (ElevenLabs → Profile → API key). Only used to fetch the catalog.
ELEVENLABS_API_KEY=
# Server-side Claude (insights / analysis) — Azure AI Foundry in Azure:
#   ANTHROPIC_BASE_URL=https://axxiom-ai.services.ai.azure.com/anthropic
#   ANTHROPIC_API_KEY=<the Foundry key>   ANTHROPIC_MODEL=<a Foundry deployment, e.g. claude-sonnet-4-6>
# Leave the base URL empty only for local dev against api.anthropic.com.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# The model the Vapi voice agents use (pushed by the assistant sync). Kept
# separate so changing the analysis deployment never changes the live agents.
VOICE_MODEL=claude-sonnet-4-6
# Run a post-call Claude pass for sentiment/objections/next-best-action.
ENABLE_TRANSCRIPT_ANALYSIS=false
# Per-campaign transcript analysis: after every N ended calls (and on demand) an
# AI reviews the batch and proposes an improvement report + improved prompt.
# Requires ANTHROPIC_API_KEY. Set to your review cadence (e.g. 25 or 50).
INSIGHT_EVERY_N_CALLS=25

# --- Legacy Supabase (DATA_BACKEND=supabase — transition only) --------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VOICE_CALL_TABLE=ax_voice_call

# --- Dashboard auth ----------------------------------------------------------
# Signs the dashboard session cookie. >= 32 random characters or auth fails
# closed (every /outbound/* request 503s). e.g.:
#   node -e 'console.log(require("crypto").randomBytes(36).toString("base64url"))'
# Accounts: `bun run dashboard-user add you@axxiomelevator.com` (invite-only).
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_HOURS=12
# Where the built dashboard lives (Next.js static export); served at "/".
# Locally, `cd web && npm run build` then DASHBOARD_DIR=web/out — or just run
# `npm run dev` in web/ (port 3001), which proxies the API to this server.
DASHBOARD_DIR=public
# Extra cross-origin dashboard origin(s) — normally EMPTY (same-origin).
DASHBOARD_ORIGIN=

# --- Business config (injected into the system prompt) --------------------
COMPANY_NAME=Axxiom Elevator
AGENT_NAME=Alex
SERVICE_AREA=the local metro area
BUSINESS_HOURS=Monday through Friday, 8 AM to 5 PM
BOOKING_TYPE=a free, no-obligation site survey
